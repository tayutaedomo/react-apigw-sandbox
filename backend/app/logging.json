{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "aws_lambda_powertools.logging.formatter.LambdaPowertoolsFormatter",
      "service": "sandbox-api",
      "utc": true,
      "use_rfc3339": true
    },
    "probe_json": {
      "()": "aws_lambda_powertools.logging.formatter.LambdaPowertoolsFormatter",
      "service": "sandbox-api-logger-probe",
      "utc": true,
      "use_rfc3339": true
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json",
      "filters": [
        "logger_name"
      ]
    },
    "probe_stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "probe_json"
    }
  },
  "loggers": {
    "app": {
      "handlers": [
        "stdout"
      ],
      "level": "INFO",
      "propagate": false
    },
    "app.logging_probe": {
      "handlers": [
        "probe_stdout"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn": {
      "handlers": [
        "stdout"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "NOTSET",
      "propagate": true
    },
    "uvicorn.access": {
      "handlers": [],
      "propagate": false
    }
  },
  "filters": {
    "logger_name": {
      "()": "app.logging_config.LoggerNameFilter"
    }
  }
}
